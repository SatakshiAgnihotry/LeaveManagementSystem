{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseEureka": true,
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://eureka-server:8761/eureka/",
      "ShouldRegisterWithEureka": false,
      "ShouldFetchRegistry": true
    }
  },
  "JwtSettings": {
    "SecretKey": "LeaveManagementSystem_SuperSecretKey_2026_JWT_Min256Bits!!",
    "Issuer": "LeaveManagementSystem",
    "Audience": "LeaveManagementSystemClients",
    "ExpirationMinutes": 60
  },
  "Jaeger": {
    "ServiceName": "ApiGateway",
    "Host": "jaeger",
    "Port": 4317,
    "SamplingRate": 1.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
