{
  "info": {
    "name": "Leave Management System",
    "_postman_id": "lms-collection-001",
    "description": "Postman collection for Leave Management System microservices via API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "employeeToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "leaveRequestId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('employeeToken', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"emp@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('managerToken', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mgr@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Employee Service",
      "item": [
        {
          "name": "Get Team",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/team",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "team"]
            }
          }
        },
        {
          "name": "Get Leave Balances",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/usr-emp-001/leave-balances",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "usr-emp-001", "leave-balances"]
            }
          }
        },
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Employee\",\n  \"email\": \"new.emp@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"]
            }
          }
        }
      ]
    },
    {
      "name": "Leave Service",
      "item": [
        {
          "name": "Apply Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.leaveRequestId) {",
                  "    pm.collectionVariables.set('leaveRequestId', json.data.leaveRequestId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"Casual\",\n  \"startDate\": \"2026-06-10T00:00:00Z\",\n  \"endDate\": \"2026-06-12T00:00:00Z\",\n  \"numberOfDays\": 2,\n  \"reason\": \"Personal work\",\n  \"managerId\": \"usr-mgr-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "apply"]
            }
          }
        },
        {
          "name": "Get My Leave History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/history?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Manager Pending Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/manager/requests?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "manager", "requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Approve Leave",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comments\": \"Approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveRequestId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveRequestId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Leave",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comments\": \"Rejected due to workload\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveRequestId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveRequestId}}", "reject"]
            }
          }
        },
        {
          "name": "Circuit Breaker Test",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/circuit-breaker/test/success",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "circuit-breaker", "test"]
            }
          }
        },
        {
          "name": "Cancel Leave",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveRequestId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveRequestId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Notification Service",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"]
            }
          }
        }
      ]
    }
  ]
}